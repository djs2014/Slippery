{
    "layout": {
        "type": "layout",
        "pages": ["page-locations", "page-display", "page-thresholds"],
        "page-locations": {
            "type": "page",
            "title": "Locations",
            "sections": ["section-loc1", "section-loc-extra"]
        },
        "page-display": {
            "type": "page",
            "title": "Panel & popup",
            "sections": ["section-fetch", "section-panel", "section-popup"]
        },
        "page-thresholds": {
            "type": "page",
            "title": "Thresholds",
            "sections": ["section-thresh"]
        },
        "section-loc1": {
            "type": "section",
            "title": "1 (primary — panel chip shows this point)",
            "keys": ["location-1-name", "location-1-coords"]
        },
        "section-loc-extra": {
            "type": "section",
            "title": "2-5 (extra commute points — empty coordinates = disabled)",
            "keys": ["location-2-name", "location-2-coords", "location-3-name", "location-3-coords", "location-4-name", "location-4-coords", "location-5-name", "location-5-coords"]
        },
        "section-fetch": {
            "type": "section",
            "title": "Fetching",
            "keys": ["refresh-minutes", "startup-delay-sec", "forecast-hours"]
        },
        "section-panel": {
            "type": "section",
            "title": "Panel chip",
            "keys": ["show-temperature", "color-mode", "color-min-level", "use-hsp-text", "hsp-threshold"]
        },
        "section-popup": {
            "type": "section",
            "title": "Popup",
            "keys": ["show-advice"]
        },
        "section-thresh": {
            "type": "section",
            "title": "Alert thresholds (like the Connect IQ app)",
            "keys": ["thresh-ice-alert", "thresh-high-crosswind", "thresh-cross-gust", "thresh-heavy-wind", "thresh-sustained-wind", "thresh-headwind", "thresh-heat-stress", "thresh-precip-ahead"]
        }
    },
    "location-1-name": {
        "type": "entry",
        "default": "Home",
        "description": "1 name",
        "tooltip": "Display name for the primary forecast point (panel chip shows this point)."
    },
    "location-1-coords": {
        "type": "entry",
        "default": "52.18895, 4.549666",
        "description": "1 latitude,longitude",
        "tooltip": "Paste straight from Google Maps: 52.387520877358256, 4.7199631014777 — or type lat, lon with dot decimals."
    },
    "location-2-name": {
        "type": "entry",
        "default": "",
        "description": "2 name",
        "tooltip": "Empty coordinates = disabled. Extra commute stop."
    },
    "location-2-coords": {
        "type": "entry",
        "default": "",
        "description": "2 latitude,longitude",
        "tooltip": "Paste from Google Maps: lat, lon. Leave empty to disable."
    },
    "location-3-name": {
        "type": "entry",
        "default": "",
        "description": "3 name",
        "tooltip": "Empty coordinates = disabled."
    },
    "location-3-coords": {
        "type": "entry",
        "default": "",
        "description": "3 latitude,longitude",
        "tooltip": "Paste from Google Maps: lat, lon. Leave empty to disable."
    },
    "location-4-name": {
        "type": "entry",
        "default": "",
        "description": "4 name",
        "tooltip": "Empty coordinates = disabled."
    },
    "location-4-coords": {
        "type": "entry",
        "default": "",
        "description": "4 latitude,longitude",
        "tooltip": "Paste from Google Maps: lat, lon. Leave empty to disable."
    },
    "location-5-name": {
        "type": "entry",
        "default": "",
        "description": "5 name",
        "tooltip": "Empty coordinates = disabled."
    },
    "location-5-coords": {
        "type": "entry",
        "default": "",
        "description": "5 latitude,longitude",
        "tooltip": "Paste from Google Maps: lat, lon. Leave empty to disable."
    },
    "refresh-minutes": {
        "type": "spinbutton",
        "default": 15,
        "min": 5,
        "max": 180,
        "step": 5,
        "units": "min",
        "description": "Refresh interval",
        "tooltip": "How often to fetch Open-Meteo data (minutes, minimum 5)."
    },
    "startup-delay-sec": {
        "type": "spinbutton",
        "default": 30,
        "min": 0,
        "max": 300,
        "step": 5,
        "units": "sec",
        "description": "Delay on startup",
        "tooltip": "The first fetch happens right away; this schedules one extra fetch N seconds after startup (covers login before the network is up). 0 = no extra fetch."
    },
    "forecast-hours": {
        "type": "spinbutton",
        "default": 8,
        "min": 1,
        "max": 12,
        "step": 1,
        "units": "h",
        "description": "Coming hours shown in popup",
        "tooltip": "How many coming forecast hours (risk + precipitation) to list in the popup. Covers the ride home after ~8h work."
    },
    "show-temperature": {
        "type": "switch",
        "default": true,
        "description": "Show air temperature next to the risk label"
    },
    "color-mode": {
        "type": "combobox",
        "default": "bright",
        "description": "Panel chip colors",
        "tooltip": "bright = vivid risk colors; modest = muted risk colors. Applies to the panel chip and the location name + risk rows in the popup. Combine with the minimum-risk setting below (Never = theme decides).",
        "options": {
            "Bright colors": "bright",
            "Modest colors": "modest"
        }
    },
    "color-min-level": {
        "type": "combobox",
        "default": "always",
        "description": "Show colors only when risk is above",
        "tooltip": "Chip and popup location rows stay uncolored (panel theme decides) below this risk level. Never = no background colors at all (replaces the old Follow theme option).",
        "options": {
            "Always (every risk level)": "always",
            "SLIGHT and above": "slight",
            "MODERATE and above": "moderate",
            "HIGH and above": "high",
            "CRITICAL only": "critical",
            "Never (no background)": "never"
        }
    },
    "use-hsp-text": {
        "type": "switch",
        "default": true,
        "description": "Auto text color via HSP luminance",
        "tooltip": "When on, chip and popup risk-row text is black/white chosen by HSP brightness of the background. When off, use fixed black-on-yellow/orange, white-on-red."
    },
    "hsp-threshold": {
        "type": "scale",
        "default": 127,
        "min": 0,
        "max": 255,
        "step": 1,
        "description": "HSP dark/light breakpoint",
        "tooltip": "HSP 0 = black, 255 = white. Backgrounds brighter than this get black text."
    },
    "show-advice": {
        "type": "switch",
        "default": true,
        "description": "Show advice in popup"
    },
    "thresh-ice-alert": {
        "type": "spinbutton",
        "default": 3.0,
        "min": -10,
        "max": 10,
        "step": 0.5,
        "units": "°C",
        "description": "Ice alert threshold",
        "tooltip": "Big ICE warning when surface temperature is at/below this (like the Connect IQ app threshIceAlert, default 3.0°C)."
    },
    "thresh-high-crosswind": {
        "type": "spinbutton",
        "default": 25,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "km/h",
        "description": "High crosswind threshold",
        "tooltip": "Mirrors Connect IQ threshHighCrosswind."
    },
    "thresh-cross-gust": {
        "type": "spinbutton",
        "default": 18,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "km/h",
        "description": "Cross gust threshold",
        "tooltip": "Mirrors Connect IQ threshCrossGust (moderate crosswind alert)."
    },
    "thresh-heavy-wind": {
        "type": "spinbutton",
        "default": 35,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "km/h",
        "description": "Heavy wind threshold",
        "tooltip": "Mirrors Connect IQ threshHeavyWind."
    },
    "thresh-sustained-wind": {
        "type": "spinbutton",
        "default": 25,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "km/h",
        "description": "Sustained wind threshold",
        "tooltip": "Mirrors Connect IQ threshSustainedWind."
    },
    "thresh-headwind": {
        "type": "spinbutton",
        "default": 12,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "km/h",
        "description": "Headwind threshold",
        "tooltip": "Mirrors Connect IQ threshHeadwind (magnitude; alert when headwind component reaches this)."
    },
    "thresh-heat-stress": {
        "type": "spinbutton",
        "default": 32,
        "min": 0,
        "max": 50,
        "step": 0.5,
        "units": "°C",
        "description": "Heat stress threshold",
        "tooltip": "Mirrors Connect IQ threshHeatStress (feels-like temperature)."
    },
    "thresh-precip-ahead": {
        "type": "spinbutton",
        "default": 0.5,
        "min": 0,
        "max": 20,
        "step": 0.1,
        "units": "mm/h",
        "description": "Precip-ahead threshold",
        "tooltip": "Mirrors Connect IQ threshPrecipAhead: forecast rain/showers at/above this flag a RAIN/SHOWERS AHEAD alert."
    }
}
